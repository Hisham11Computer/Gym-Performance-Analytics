{
  "name": "Gym Performance Dark",
  "dataColors": ["#14B8A6", "#F59E0B", "#3B82F6", "#F43F5E", "#8B5CF6", "#22C55E", "#64748B", "#EAB308"],
  "background": "#1F2937",
  "foreground": "#E5E7EB",
  "tableAccent": "#14B8A6",
  "good": "#22C55E",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#14B8A6",
  "center": "#F59E0B",
  "minimum": "#EF4444",
  "textClasses": {
    "callout": { "fontSize": 36, "fontFace": "Segoe UI Semibold", "color": "#FFFFFF" },
    "title":   { "fontSize": 14, "fontFace": "Segoe UI Semibold", "color": "#E5E7EB" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E5E7EB" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#CBD5E1" }
  },
  "visualStyles": {
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#111827" } }, "transparency": 0 }] }
    },
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#1F2937" } }, "transparency": 0 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#E5E7EB" } }, "fontSize": 14 }]
      }
    }
  }
}
